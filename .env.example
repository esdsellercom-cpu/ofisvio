APP_NAME=Ofisvio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Istanbul

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Üretimde true (HTTPS zorunlu) — ofisvio:doctor üretimde bunu şart koşar.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# HTTPS yanıtlarına Strict-Transport-Security (SecurityHeaders); ters proxy zaten ekliyorsa false.
SECURITY_HSTS=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="panel@ofisvio.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# KYC belge karantinasi: clamav (uretim) | none (yalnizca gelistirme)
KYC_SCANNER=none
CLAMAV_ADDRESS=tcp://127.0.0.1:3310
CLAMAV_TIMEOUT=30

# Hesap açılışı (php artisan ofisvio:bootstrap-accounts). Şifre kaynak kodda YOKTUR;
# ≥16 karakter, büyük/küçük harf, rakam, özel karakter. Test müşterisi production'da açılmaz.
OFISVIO_ADMIN_EMAIL=
OFISVIO_ADMIN_PASSWORD=
OFISVIO_TEST_CUSTOMER_EMAIL=
OFISVIO_TEST_CUSTOMER_PASSWORD=

# Entegrasyonlar (faz 5): her sağlayıcı kapalı; açmak için *_ENABLED=true ve secret'lar.
# Değerler yalnız env'de; kodda/veritabanında tutulmaz.
INTEGRATION_TIMEOUT=10
WEBHOOK_TOLERANCE=300
IYZICO_ENABLED=false
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_WEBHOOK_SECRET=
# IndexNow (faz 44): anahtar panelde (SEO & GEO › Doğrulama & bildirim); burada yalnız açma/kapama.
INDEXNOW_ENABLED=false
SEARCH_CONSOLE_ENABLED=false
SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON=
ANALYTICS_ENABLED=false
ANALYTICS_SERVICE_ACCOUNT_JSON=
AI_ENABLED=false
AI_API_KEY=
WHATSAPP_ENABLED=false
WHATSAPP_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=
# Bildirim merkezi ilk alici (ofisvio:bootstrap-notifications); sonrasi panelden yonetilir
OFISVIO_BOOKING_NOTIFY_WHATSAPP=
SMS_ENABLED=false
SMS_BASE_URL=
SMS_API_KEY=
SMS_WEBHOOK_SECRET=
EFATURA_ENABLED=false
EFATURA_BASE_URL=
EFATURA_USERNAME=
EFATURA_PASSWORD=
EFATURA_WEBHOOK_SECRET=
