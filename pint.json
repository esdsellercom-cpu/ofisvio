{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": false,
        "final_class": false,
        "ordered_imports": { "sort_algorithm": "alpha" },
        "no_unused_imports": true,
        "php_unit_method_casing": { "case": "snake_case" },
        "not_operator_with_successor_space": true,
        "single_quote": true,
        "trailing_comma_in_multiline": true
    },
    "exclude": [
        "bootstrap/cache",
        "storage",
        "vendor"
    ]
}
